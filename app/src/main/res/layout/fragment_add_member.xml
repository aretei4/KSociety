<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/header_green" android:gravity="center_vertical"
            android:orientation="horizontal" android:padding="16dp">
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="36dp" android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_nav_back" android:tint="@color/white"
                android:contentDescription="Back"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Add Member" android:textColor="@color/white"
                    android:textSize="18sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tv_fund_name" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <!-- Avatar preview -->
            <FrameLayout
                android:id="@+id/frame_avatar_preview"
                android:layout_width="60dp" android:layout_height="60dp"
                android:layout_gravity="center_horizontal" android:layout_marginBottom="20dp"
                android:background="@drawable/bg_avatar" android:visibility="gone">
                <TextView android:id="@+id/tv_avatar_preview"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:textColor="@color/header_green"
                    android:textSize="20sp" android:textStyle="bold"/>
            </FrameLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:text="FULL NAME *"
                android:textColor="@color/text_muted" android:textSize="11sp" android:textStyle="bold"/>
            <EditText android:id="@+id/et_name" android:layout_width="match_parent" android:layout_height="50dp"
                android:layout_marginBottom="16dp" android:background="@drawable/bg_input_field"
                android:hint="e.g. Ravi Kumar" android:inputType="textCapWords|textPersonName"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="14sp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:text="PHONE NUMBER"
                android:textColor="@color/text_muted" android:textSize="11sp" android:textStyle="bold"/>
            <EditText android:id="@+id/et_phone" android:layout_width="match_parent" android:layout_height="50dp"
                android:layout_marginBottom="16dp" android:background="@drawable/bg_input_field"
                android:hint="e.g. 9876543210" android:inputType="phone"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="14sp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:text="MONTHLY CONTRIBUTION (₹) *"
                android:textColor="@color/text_muted" android:textSize="11sp" android:textStyle="bold"/>
            <EditText android:id="@+id/et_contribution" android:layout_width="match_parent" android:layout_height="50dp"
                android:layout_marginBottom="16dp" android:background="@drawable/bg_input_field"
                android:hint="e.g. 2000" android:inputType="number"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="14sp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:text="MONTHLY MEMBER FEE (₹)"
                android:textColor="@color/text_muted" android:textSize="11sp" android:textStyle="bold"/>
            <EditText android:id="@+id/et_fee" android:layout_width="match_parent" android:layout_height="50dp"
                android:layout_marginBottom="16dp" android:background="@drawable/bg_input_field"
                android:hint="e.g. 500" android:inputType="number"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="14sp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" android:text="LOAN AMOUNT (₹)"
                android:textColor="@color/text_muted" android:textSize="11sp" android:textStyle="bold"/>
            <EditText android:id="@+id/et_loan" android:layout_width="match_parent" android:layout_height="50dp"
                android:layout_marginBottom="20dp" android:background="@drawable/bg_input_field"
                android:hint="0 if no loan" android:inputType="number"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="14sp"/>

            <!-- Preview -->
            <LinearLayout android:id="@+id/layout_preview" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="20dp"
                android:background="@drawable/bg_accent_soft" android:gravity="center_vertical"
                android:orientation="horizontal" android:padding="14dp" android:visibility="gone">
                <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                    android:layout_marginEnd="10dp" android:background="@drawable/bg_avatar">
                    <TextView android:id="@+id/tv_preview_avatar" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_gravity="center"
                        android:textColor="@color/header_green" android:textSize="13sp" android:textStyle="bold"/>
                </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/tv_preview_name" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text_primary"
                        android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tv_preview_detail" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text_muted" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/btn_save_member" android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/bg_button_primary" android:text="✓  Add Member"
                android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
