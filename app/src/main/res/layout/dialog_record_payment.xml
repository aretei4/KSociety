<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" android:text="Principal (₹)"
        android:textColor="@color/color_blue" android:textSize="12sp" android:textStyle="bold"/>
    <EditText android:id="@+id/et_pay_amount" android:layout_width="match_parent"
        android:layout_height="46dp" android:layout_marginBottom="10dp"
        android:background="@drawable/bg_input_field" android:hint="0"
        android:inputType="number" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" android:text="Interest (₹)"
        android:textColor="@color/color_green" android:textSize="12sp" android:textStyle="bold"/>
    <EditText android:id="@+id/et_pay_interest" android:layout_width="match_parent"
        android:layout_height="46dp" android:layout_marginBottom="10dp"
        android:background="@drawable/bg_input_field" android:hint="0"
        android:inputType="number" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" android:text="Penalty (₹)"
        android:textColor="@color/color_red" android:textSize="12sp" android:textStyle="bold"/>
    <EditText android:id="@+id/et_pay_penalty" android:layout_width="match_parent"
        android:layout_height="46dp" android:layout_marginBottom="10dp"
        android:background="@drawable/bg_input_field" android:hint="0"
        android:inputType="number" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="4dp" android:text="Member Fee (₹)"
        android:textColor="@color/color_orange" android:textSize="12sp" android:textStyle="bold"/>
    <EditText android:id="@+id/et_pay_fee" android:layout_width="match_parent"
        android:layout_height="46dp" android:background="@drawable/bg_input_field" android:hint="0"
        android:inputType="number" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp"/>
</LinearLayout>
