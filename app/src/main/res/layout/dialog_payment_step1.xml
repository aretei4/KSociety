<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- Title row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Select Member" android:textColor="#1A1F1C"
                android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Step 1 of 3" android:textColor="#8A9690" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:id="@+id/btn_close" android:layout_width="32dp" android:layout_height="32dp"
            android:background="@drawable/bg_close_btn" android:gravity="center"
            android:text="✕" android:textColor="#8A9690" android:textSize="14sp"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <!-- Progress -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:weightSum="3"
        android:layout_marginTop="12dp" android:layout_marginBottom="20dp">
        <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1"
            android:background="#1F5C3A" android:layout_marginEnd="4dp"/>
        <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1"
            android:background="#E2E8E4" android:layout_marginEnd="4dp"/>
        <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1"
            android:background="#E2E8E4"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="CHOOSE MEMBER" android:textColor="#8A9690"
        android:textSize="11sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>

    <!-- Search -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
        android:background="@drawable/bg_input_field" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp"
        android:layout_marginBottom="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔍" android:textSize="15sp" android:layout_marginEnd="8dp"/>
        <EditText android:id="@+id/et_search_member" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:background="@null" android:hint="Search member..."
            android:textColorHint="#8A9690" android:textSize="13sp" android:inputType="text"/>
        <TextView android:id="@+id/btn_clear_search" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="✕" android:textSize="14sp"
            android:textColor="#8A9690" android:padding="6dp" android:visibility="gone"/>
    </LinearLayout>

    <!-- Member list: fixed height so button is always below -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_members"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:nestedScrollingEnabled="true"/>

    <!-- Continue always anchored at bottom -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:text="Continue →"
        android:textColor="#8A9690"
        android:textSize="14sp"
        android:textStyle="bold"
        android:enabled="false"
        app:backgroundTint="#E2E8E4"
        app:cornerRadius="14dp"
        app:elevation="0dp"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

</LinearLayout>