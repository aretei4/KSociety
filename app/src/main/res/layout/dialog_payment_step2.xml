<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Enter Amounts" android:textColor="#1A1F1C"
                android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Step 2 of 3" android:textColor="#8A9690" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:id="@+id/btn_close" android:layout_width="32dp" android:layout_height="32dp"
            android:background="@drawable/bg_close_btn" android:gravity="center"
            android:text="✕" android:textColor="#8A9690" android:textSize="14sp"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <!-- Progress -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp" android:weightSum="3">
        <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1"
            android:background="#1F5C3A" android:layout_marginEnd="4dp"/>
        <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1"
            android:background="#1F5C3A" android:layout_marginEnd="4dp"/>
        <View android:layout_width="0dp" android:layout_height="3dp" android:layout_weight="1"
            android:background="#E2E8E4"/>
    </LinearLayout>

    <!-- Selected member banner -->
    <LinearLayout android:id="@+id/layout_selected_member"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_member_selected_banner"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="12dp" android:layout_marginBottom="16dp">
        <FrameLayout android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/bg_avatar" android:layout_marginEnd="10dp">
            <TextView android:id="@+id/tv_member_avatar" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center"
                android:textColor="#1F5C3A" android:textSize="11sp" android:textStyle="bold"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_member_name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#1A1F1C"
                android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_outstanding_info" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#8A9690" android:textSize="12sp"/>
        </LinearLayout>
        <TextView android:id="@+id/btn_change_member" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Change"
            android:textColor="#1F5C3A" android:textSize="13sp" android:textStyle="bold"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <!-- Scroll container for amount cards -->
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="320dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Principal Repayment card -->
            <LinearLayout android:id="@+id/card_principal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_amount_card"
                android:orientation="vertical" android:padding="14dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_icon_blue" android:layout_marginEnd="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center" android:text="🏦" android:textSize="14sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Principal Repayment" android:textColor="#1A56A0"
                            android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tv_principal_hint" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="#8A9690" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                    android:background="@drawable/bg_amount_input" android:orientation="horizontal"
                    android:gravity="center_vertical" android:paddingStart="12dp"
                    android:paddingEnd="12dp" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="₹" android:textSize="16sp" android:textColor="#8A9690"
                        android:layout_marginEnd="4dp"/>
                    <EditText android:id="@+id/et_principal" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1"
                        android:background="@null" android:hint="0" android:textColorHint="#8A9690"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#1A1F1C"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_principal_quickfill"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </LinearLayout>

            <!-- Interest card -->
            <LinearLayout android:id="@+id/card_interest"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_amount_card"
                android:orientation="vertical" android:padding="14dp" android:layout_marginBottom="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_icon_green" android:layout_marginEnd="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center" android:text="📈" android:textSize="14sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Interest" android:textColor="#1F7A4A"
                            android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tv_interest_hint" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="#8A9690" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                    android:background="@drawable/bg_amount_input" android:orientation="horizontal"
                    android:gravity="center_vertical" android:paddingStart="12dp"
                    android:paddingEnd="12dp" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="₹" android:textSize="16sp" android:textColor="#8A9690"
                        android:layout_marginEnd="4dp"/>
                    <EditText android:id="@+id/et_interest" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1"
                        android:background="@null" android:hint="0" android:textColorHint="#8A9690"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#1A1F1C"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_interest_quickfill"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </LinearLayout>

            <!-- Penalty card -->
            <LinearLayout android:id="@+id/card_penalty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_amount_card"
                android:orientation="vertical" android:padding="14dp" android:layout_marginBottom="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_icon_orange" android:layout_marginEnd="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center" android:text="⚠️" android:textSize="14sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Penalty" android:textColor="#D4600A"
                            android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Late payment penalty (if any)"
                            android:textColor="#8A9690" android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                    android:background="@drawable/bg_amount_input" android:orientation="horizontal"
                    android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="₹" android:textSize="16sp" android:textColor="#8A9690"
                        android:layout_marginEnd="4dp"/>
                    <EditText android:id="@+id/et_penalty" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1"
                        android:background="@null" android:hint="0" android:textColorHint="#8A9690"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#1A1F1C"
                        android:inputType="number"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Member Fee card -->
            <LinearLayout android:id="@+id/card_fee"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_amount_card"
                android:orientation="vertical" android:padding="14dp" android:layout_marginTop="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <FrameLayout android:layout_width="30dp" android:layout_height="30dp"
                        android:background="@drawable/bg_icon_orange" android:layout_marginEnd="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center" android:text="🪙" android:textSize="14sp"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Member Fee" android:textColor="#D4600A"
                            android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tv_fee_hint" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="#8A9690" android:textSize="11sp"
                            android:text="Monthly admin fee"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="46dp"
                    android:background="@drawable/bg_amount_input" android:orientation="horizontal"
                    android:gravity="center_vertical" android:paddingStart="12dp"
                    android:paddingEnd="12dp" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="₹" android:textSize="16sp" android:textColor="#8A9690"
                        android:layout_marginEnd="4dp"/>
                    <EditText android:id="@+id/et_fee" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1"
                        android:background="@null" android:hint="0" android:textColorHint="#8A9690"
                        android:textSize="18sp" android:textStyle="bold" android:textColor="#1A1F1C"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/layout_fee_quickfill"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom buttons -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="16dp" android:weightSum="3">
        <Button android:id="@+id/btn_back" android:layout_width="0dp" android:layout_height="50dp"
            android:layout_weight="1" android:layout_marginEnd="10dp"
            android:background="@drawable/btn_back_outline"
            android:text="← Edit" android:textColor="#8A9690"
            android:textSize="13sp" android:textStyle="bold"/>
        <Button android:id="@+id/btn_review" android:layout_width="0dp" android:layout_height="50dp"
            android:layout_weight="2" android:background="@drawable/btn_primary_green"
            android:text="Review →" android:textColor="#FFFFFF"
            android:textSize="14sp" android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
