<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BCCommittee" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/header_green</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:statusBarColor">@color/header_green</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <style name="Theme.BCCommittee.Splash" parent="Theme.BCCommittee">
        <item name="android:windowBackground">@color/header_green</item>
        <item name="android:statusBarColor">@color/header_green</item>
    </style>

    <style name="Theme.BCCommittee.BottomSheet" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/RoundedTopCorners</item>
        <item name="android:background">@color/surface</item>
    </style>

    <style name="RoundedTopCorners">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <!-- Text Styles -->
    <style name="TextStyle.Title" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextStyle.Body" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_mid</item>
    </style>

    <style name="TextStyle.Caption" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextStyle.Amount" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Button Styles -->
    <style name="ButtonStyle.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/header_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ButtonStyle.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/border_color</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Input Field -->
    <style name="InputField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/header_green</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:background">@color/bg_main</item>
    </style>

    <!-- Pill Status -->
    <style name="Pill.Paid" parent="">
        <item name="android:background">@drawable/pill_green_bg</item>
        <item name="android:textColor">@color/color_green</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="Pill.Pending" parent="">
        <item name="android:background">@drawable/pill_orange_bg</item>
        <item name="android:textColor">@color/color_orange</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
</resources>
<!-- Adding LabelStyle referenced in layouts -->
